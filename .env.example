# Railway web application
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
APP_ORIGIN=http://127.0.0.1:4173

# Public Railway hosting requires three different passwords of at least 16 characters.
# Team sign-in uses email only. These addresses also backfill existing accounts
# that have no email; saved emails, passwords and roles are never overwritten.
ARVIE_EMAIL=
KEZIAH_EMAIL=
MACY_EMAIL=
ARVIE_PASSWORD=
KEZIAH_PASSWORD=
MACY_PASSWORD=

# New reasoning layer. Keep codex_worker during development. Switching to Claude
# requires both Claude settings and the explicit provider change.
AI_PROVIDER=codex_worker
STUDIO_WORKER_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
DAILY_ANALYSIS_LIMIT=10

# Active video provider. HeyGen supplies both the voice and talking footage;
# Railway performs the final portrait composition and review workflow.
VIDEO_PROVIDER=heygen
HEYGEN_API_KEY=
DAILY_VIDEO_LIMIT=2

# Google OAuth reads pasted Docs and writes Macy-approved outputs to Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Retained only for historical jobs. New direct-document jobs do not require it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Docker installs these. Local development may override them.
FFMPEG_PATH=
FFPROBE_PATH=
LOGO_CHROMIUM_PATH=
VISUAL_PYTHON_PATH=
