# Node 24 or later. Local source inspection works without credentials.
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
APP_ORIGIN=http://127.0.0.1:4173
# On Railway set APP_ORIGIN to the HTTPS domain and set all three passwords.
# Use different passwords with at least 16 characters. Keep keys out of chat.
ARVIE_PASSWORD=
KEZIAH_PASSWORD=
MACY_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Each analysis includes drafting and a separate model review.
DAILY_ANALYSIS_LIMIT=10
# Google OAuth web client. Add ID/secret, deploy, then use Connections > Connect Google.
# Live reads need Sheets/Docs scopes; approved uploads need Drive scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional pre-existing refresh credential; Connect Google stores its own on /data.
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
# ClickUp approval checks and credentials are deferred for this manual pilot.

# HeyGen API pay-as-you-go key; library presenter + voice + video in one request.
HEYGEN_API_KEY=
DAILY_VIDEO_LIMIT=2
# Optional custom binary paths. Docker installs these automatically.
FFMPEG_PATH=
FFPROBE_PATH=
LOGO_CHROMIUM_PATH=
# Docker includes the local face/crop and logo-text screening runtime.
# Local development: Python 3.11/3.12 with opencv-python 4.13.0.92 and rapidocr-onnxruntime 1.4.4.
VISUAL_PYTHON_PATH=
