# Copy to the repository root as .env.worker. That file is ignored by Git.
STUDIO_URL=https://article-video-studio-production.up.railway.app
STUDIO_WORKER_TOKEN=
STUDIO_WORKER_ID=arvie-windows
STUDIO_WORKER_TYPES=ai_codex,media_local

# Optional executable overrides.
CODEX_BIN=codex
# Optional on managed networks that provide a custom certificate bundle.
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=
NODE_EXTRA_CA_CERTS=
LOCAL_MEDIA_PYTHON=
SADTALKER_DIR=
SADTALKER_PYTHON=
KOKORO_MODEL=
KOKORO_VOICES=
LOCAL_MEDIA_DEVICE=cpu
MEDIA_RENDER_TIMEOUT_MS=21600000
FFMPEG_PATH=
TORCH_HOME=

# A Railway LiteAvatar service uses only media_liteavatar and receives these
# paths from Dockerfile.liteavatar. They are shown here for local smoke tests.
LITEAVATAR_PYTHON=
LITEAVATAR_DIR=
LITEAVATAR_PROFILES_DIR=
MPLCONFIGDIR=
